@startuml
title DataPipe - Etats-Transitions Orchestration (UML pur)
skinparam shadowing false

state "Schedule.active" as ScheduleState {
  [*] --> Active
  Active --> Paused : suspension
  Paused --> Active : reprise
}

state "Datasource.sync_status" as DSSync {
  [*] --> idle
  idle --> syncing : demande synchronisation
  syncing --> idle : sync terminee
  syncing --> failed : erreur connecteur
  failed --> syncing : relance
}

state "AssistantInteraction.status" as AState {
  [*] --> queued
  queued --> processing : message recu
  processing --> answered : reponse generee
  processing --> escalated : confiance insuffisante
  escalated --> answered : validation humaine
  processing --> failed : erreur service
}

@enduml
