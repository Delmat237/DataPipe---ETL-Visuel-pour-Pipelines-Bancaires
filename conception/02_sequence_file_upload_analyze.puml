@startuml
title DataPipe - Sequence Technique Ingestion et Analyse (UML pur)
autonumber
skinparam shadowing false

actor "Operateur metier" as U
participant "Interface <<boundary>>" as IHM
participant "ServiceIngestion <<control>>" as Service
participant "FichierController <<control>>" as Ctrl
participant "RegleAcces <<control>>" as Regles
participant "Fichier <<entity>>" as File
database "BaseDonnees <<entity>>" as DB
collections "StockageFichier <<entity>>" as Storage

U -> IHM : Deposer fichier + workspace
IHM -> Service : initier ingestion
Service -> Ctrl : upload(file, workspace)
Ctrl -> Regles : verifier droits (editor)
Regles --> Ctrl : autorise / refuse
alt acces refuse
  Ctrl --> Service : refus d'acces
  Service --> IHM : erreur d'autorisation
else acces autorise
  Ctrl -> Storage : ecrire artefact
  Ctrl -> Ctrl : extraire metadonnees
  Ctrl -> File : instancier objet metier
  File -> DB : persister
  DB --> File : commit
  Ctrl --> Service : fiche fichier
  Service --> IHM : confirmation ingestion
end

U -> IHM : Demander analyse du fichier
IHM -> Service : analyser(file_id)
Service -> Ctrl : analyze(file_id)
Ctrl -> File : charger(file_id)
File -> DB : lire
DB --> File : objet fichier
Ctrl -> Ctrl : inferer colonnes/types
Ctrl --> Service : rapport qualite
Service --> IHM : resultat analyse

@enduml
