@startuml
title DataPipe - Sequence Technique Authentification (UML pur)
autonumber
skinparam shadowing false

actor "Utilisateur" as U
participant "Interface <<boundary>>" as IHM
participant "ServiceAuthentification <<control>>" as Service
participant "AuthController <<control>>" as Ctrl
participant "Utilisateur <<entity>>" as User
participant "SessionUtilisateur <<entity>>" as Session
database "BaseDonnees <<entity>>" as DB

U -> IHM : Saisir identifiants
IHM -> Service : Demander authentification
Service -> Ctrl : login(credentials)
Ctrl -> User : rechercher(email)
User --> Ctrl : utilisateur
Ctrl -> Ctrl : verifier mot de passe
alt identifiants invalides
  Ctrl --> Service : refus
  Service --> IHM : message d'erreur
else succes
  Ctrl -> Session : creer session
  Session -> DB : persister session + jetons
  DB --> Session : commit
  Ctrl --> Service : contexte de session
  Service --> IHM : succes + contexte utilisateur
end

@enduml
