@startuml
title DataPipe - Diagramme de Classes Techniques Systeme (UML pur)
skinparam shadowing false
skinparam classAttributeIconSize 0

class InterfaceUtilisateur <<boundary>> {
  +soumettreCommande()
  +afficherEtatRun()
  +afficherResultats()
}

class AssistantTelegramGateway <<boundary>> {
  +recevoirMessage()
  +retournerReponse()
}

class ServiceApplicatif <<control>> {
  +authentifier()
  +orchestrerPipeline()
  +analyserDonnees()
  +exporterResultats()
}

class AuthController <<control>> {
  +login()
  +refreshSession()
}

class PipelineController <<control>> {
  +createPipeline()
  +updatePipeline()
  +runPipeline()
}

class FileController <<control>> {
  +uploadFile()
  +analyzeFile()
}

class MoteurTransformation <<control>> {
  +executePipeline()
  +evaluateNode()
}

class LLMConnector <<control>> {
  +generateTransform()
  +explainNode()
}

class Pipeline <<entity>> {
  +id
  +status
  +lastRunStatus
}

class Run <<entity>> {
  +id
  +status
  +trigger
}

class FichierMetier <<entity>> {
  +id
  +rowsCount
  +columnsCount
}

class SessionUtilisateur <<entity>> {
  +id
  +revoked
}

class Repository <<entity>> {
  +save()
  +findById()
  +query()
}

database "BaseDonnees <<entity>>" as DB
collections "StockageArtefacts <<entity>>" as Storage

InterfaceUtilisateur --> ServiceApplicatif
AssistantTelegramGateway --> ServiceApplicatif

ServiceApplicatif --> AuthController
ServiceApplicatif --> PipelineController
ServiceApplicatif --> FileController

PipelineController --> MoteurTransformation
MoteurTransformation --> LLMConnector

AuthController --> SessionUtilisateur
PipelineController --> Pipeline
PipelineController --> Run
FileController --> FichierMetier

SessionUtilisateur --> Repository
Pipeline --> Repository
Run --> Repository
FichierMetier --> Repository
Repository --> DB

PipelineController --> Storage
FileController --> Storage

@enduml
