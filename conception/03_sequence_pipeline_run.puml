@startuml
title DataPipe - Sequence Technique Pilotage Pipeline (UML pur)
autonumber
skinparam shadowing false

actor "Operateur metier" as U
actor "Assistant Telegram" as TG
participant "Interface <<boundary>>" as IHM
participant "ServiceOrchestration <<control>>" as Service
participant "RunController <<control>>" as Ctrl
participant "MoteurTransformation <<control>>" as Engine
participant "LLMConnector <<control>>" as LLM
participant "Pipeline <<entity>>" as Pipeline
participant "Run <<entity>>" as Run
database "BaseDonnees <<entity>>" as DB
collections "StockageResultats <<entity>>" as Storage

U -> IHM : Declencher execution pipeline
IHM -> Service : run(pipeline_id)
Service -> Ctrl : trigger(pipeline_id)
Ctrl -> Pipeline : charger(pipeline_id)
Pipeline -> DB : lecture pipeline
DB --> Pipeline : definition pipeline
Ctrl -> Run : creer(status=pending)
Run -> DB : persister run
DB --> Run : commit

Ctrl -> Engine : executer(pipeline, run)
Engine -> LLM : demander assistance (si noeud IA)
LLM --> Engine : recommandations / SQL
Engine -> Engine : traiter noeuds et transitions
Engine --> Ctrl : etat final + resultats

Ctrl -> Run : maj(status,node_results)
Run -> DB : mise a jour run
Ctrl -> Storage : ecrire resultat complet
Ctrl -> Pipeline : maj(last_run_status)
Pipeline -> DB : commit

Ctrl --> Service : execution terminee
Service --> IHM : etat run + acces resultats

TG -> Service : requete statut run
Service --> TG : progression / completion

@enduml
