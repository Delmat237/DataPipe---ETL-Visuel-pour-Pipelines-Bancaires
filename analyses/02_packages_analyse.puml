@startuml
title DataPipe - Diagramme de Packages d'Analyse (UML Systeme)
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle

package "Interaction utilisateur" as PInteraction {
  package "Portail operationnel" as Portail
  package "Canal conversationnel Telegram" as CanalTelegram
}

package "Couche applicative" as PApplicative {
  package "Gestion des identites et acces" as Acces
  package "Orchestration des pipelines" as Orchestration
  package "Pilotage des executions" as Pilotage
  package "Qualite, export et supervision" as Supervision
}

package "Domaine metier" as PDomaine {
  package "Organisation et gouvernance" as DomGouv
  package "Pipeline et transformation" as DomPipe
  package "Execution et resultat" as DomRun
}

package "Infrastructure" as PInfra {
  package "Persistence relationnelle" as Pers
  package "Stockage artefacts" as Artefacts
  package "Connecteurs externes" as Conn
  package "Service LLM" as PLLM
}

Portail ..> PApplicative
CanalTelegram ..> PApplicative

Acces ..> PDomaine
Orchestration ..> PDomaine
Pilotage ..> PDomaine
Supervision ..> PDomaine

PApplicative ..> Pers
PApplicative ..> Artefacts
PApplicative ..> Conn
PApplicative ..> PLLM

@enduml
