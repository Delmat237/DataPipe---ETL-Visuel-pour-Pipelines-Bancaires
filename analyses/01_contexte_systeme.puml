@startuml
title DataPipe - Diagramme de Contexte Systeme (UML)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Operateur metier" as Operateur
actor "Administrateur plateforme" as Admin
actor "Auditeur / Controle interne" as Auditeur
actor "Assistant Telegram" as Telegram
actor "LLM Externe" as LLM
actor "Systeme tiers\n(API / Core banking / Webhook)" as Tiers

rectangle "Systeme DataPipe" as Systeme {
  rectangle "Couche interaction\n(portail + conversation)" as Interaction
  rectangle "Couche applicative" as Applicative
  rectangle "Couche donnees\n(etat metier)" as Donnees
}

database "Base de donnees" as DB
folder "Stockage de fichiers\n(uploads, resultats)" as Storage
cloud "Connecteurs de donnees" as Connecteurs

Operateur --> Interaction : Configure et pilote les flux
Admin --> Interaction : Gouverne l'acces et les environnements
Auditeur --> Interaction : Consulte preuves et traces
Telegram --> Interaction : Dialogue operationnel

Interaction --> Applicative : Commandes metier
Applicative --> Donnees : Mise a jour des objets metier
Donnees --> DB : Persistance relationnelle
Applicative --> Storage : Lecture/ecriture artefacts
Applicative --> Connecteurs : Ingestion/exposition
Applicative --> LLM : Assistance intelligente
Tiers --> Applicative : Evenements et echanges

@enduml
