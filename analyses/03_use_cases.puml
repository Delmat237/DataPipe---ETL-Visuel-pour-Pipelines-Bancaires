@startuml
title DataPipe - Diagramme de Cas d'Usage Systeme (UML)
left to right direction
skinparam shadowing false

actor "Operateur metier" as Operateur
actor "Administrateur plateforme" as Admin
actor "Auditeur interne" as Auditeur
actor "Assistant Telegram" as Telegram
actor "LLM Externe" as LLM
actor "Systeme tiers" as Tiers

rectangle "Systeme DataPipe" {
  usecase "S'authentifier et gerer les sessions" as UC_Auth
  usecase "Configurer les organisations et roles" as UC_Roles
  usecase "Concevoir un pipeline de donnees" as UC_Design
  usecase "Executer un pipeline" as UC_Run
  usecase "Superviser un run et analyser les logs" as UC_Monitor
  usecase "Exporter les resultats" as UC_Export
  usecase "Planifier les executions" as UC_Schedule
  usecase "Connecter des sources et fichiers" as UC_Sources
  usecase "Dialoguer via assistant Telegram" as UC_Telegram
  usecase "Demander une assistance intelligente" as UC_AI
  usecase "Recevoir et emettre des webhooks" as UC_Webhooks
  usecase "Produire des traces d'audit" as UC_Audit
}

Operateur --> UC_Auth
Operateur --> UC_Design
Operateur --> UC_Run
Operateur --> UC_Monitor
Operateur --> UC_Export
Operateur --> UC_Sources
Operateur --> UC_Telegram
Operateur --> UC_AI

Admin --> UC_Roles
Admin --> UC_Schedule
Admin --> UC_Webhooks
Admin --> UC_Audit

Auditeur --> UC_Audit
Telegram --> UC_Telegram
LLM --> UC_AI
Tiers --> UC_Webhooks

UC_Run .> UC_Monitor : <<include>>
UC_Run .> UC_Export : <<extend>>
UC_Design .> UC_Sources : <<include>>
UC_Telegram .> UC_Run : <<include>>

@enduml
